# ─── API Keys ────────────────────────────────────────────────────────────────
# Polygon.io — data provider (free tier works for basic scanner)
POLYGON_API_KEY=your_polygon_api_key_here

# Alpaca — paper trading broker
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# ─── Mode ─────────────────────────────────────────────────────────────────────
# Leave DRY_RUN=true until you're confident in the bot's behaviour
# DRY_RUN=true means no orders are placed, even in paper mode
BOT_DRY_RUN=true
BOT_PAPER_TRADING=true

# ─── Notes ───────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real keys.
# Never commit .env to git — it is in .gitignore.
# Polygon free tier: 5 API calls/minute. Upgrade for real-time websocket data.
# Alpaca paper trading: free at https://alpaca.markets
